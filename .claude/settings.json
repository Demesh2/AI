{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Code review plugin active: reviewing command safety.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Code review plugin: file edited — remember to run review before committing.'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Code review plugin: new file written — remember to run review before committing.'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/code-review.sh)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
